# Database
DATABASE_URL=postgres://mentora:mentora@localhost:5432/mentora

# Auth — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
APP_URL=http://localhost:3000

# Payments: "mock" (test gateway, never in production) or "sslcommerz"
PAYMENT_PROVIDER=mock
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false

# Show profiles flagged as sample data (set to false in production)
SHOW_SAMPLE_DATA=true
# Expert who receives the AI for Leaders facilitator share
AI_FACILITATOR_EXPERT_SLUG=arifuzzaman-antor

# Seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SEED_SAMPLE_DATA=true
DEMO_PASSWORD=
